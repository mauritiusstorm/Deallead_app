# ── Frontend (exposed to the browser bundle — never put secrets here) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_APP_URL=http://localhost:5173

# Set to "true" to connect the app to the local Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS=true

# ── Backend / Cloud Functions secrets ──
# Never committed. Set via `firebase functions:secrets:set <NAME>` in
# production, and functions/.secret.local (gitignored) for the emulator.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=
